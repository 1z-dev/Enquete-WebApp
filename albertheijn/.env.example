APP_NAME="Paden Van Verstand"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Kies hier de database die je server gebruikt.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Voor MySQL gebruik bijvoorbeeld:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=albertheijn
# DB_USERNAME=root
# DB_PASSWORD=

# Database-sessies werken als de sessions-migratie is uitgevoerd.
SESSION_DRIVER=database

CACHE_STORE=file
QUEUE_CONNECTION=database
